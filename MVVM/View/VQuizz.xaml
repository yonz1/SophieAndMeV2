    <UserControl.Resources>
        <ResourceDictionary>
            <core:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Style/ButtonStyle.xaml" />
                <ResourceDictionary Source="/Style/Dark_theme.xaml" />
                <ResourceDictionary Source="/Style/General.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>

        <!--  ########################################################## Panel d'affichage des matiére disponible  -->

        <Grid x:Name="Selection" Visibility="Visible">

            <Grid.RowDefinitions>
                <RowDefinition Height="100" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <Border
                Height="50"
                Grid.Row="0"
                HorizontalAlignment="Center"
                Background="{StaticResource main_background}"
                BorderThickness="2"
                CornerRadius="20">
                <DockPanel
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    LastChildFill="True">

                    <ItemsControl ItemsSource="{Binding Subjects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"></StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="1.5">
                                    <Button
                                        Width="55"
                                        Height="40"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="20"
                                        Command="{Binding SelectCommand}"
                                        DockPanel.Dock="Left"
                                        Foreground="{StaticResource Textcolor}"
                                        Style="{StaticResource topquizzmat}">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <fs:IconImage
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource Iconcolor}"
                                                Icon="{Binding IconVal}"
                                                Style="{StaticResource NewMButtonIcon}" />
                                        </StackPanel>
                                    </Button>
                                    <Label
                                        Margin="0,0,1.5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="Red"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Content="{Binding Name}"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource Textcolor}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


