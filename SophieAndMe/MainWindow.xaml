<Window
    x:Class="SophieAndMe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="1280"
    Height="740"
    AllowsTransparency="False"
    FontFamily="{DynamicResource MaterialDesignFont}"
    Loaded="Window_Loaded"
    ResizeMode="CanResize"
    TextElement.FontSize="10"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">
    
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Style/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource main_back_wind}">


        <Border Background="{StaticResource pageBackground}" CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100*" />
                </Grid.ColumnDefinitions>


                <Border
                    Grid.Column="2"
                    Background="Transparent"
                    CornerRadius="10"
                    MouseDown="Grid_MouseDown">
                    <Grid
                        Margin="0,0,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        MouseDown="Grid_MouseDown"
                        Visibility="Visible">
                        <DockPanel>
                            <TextBlock
                                Margin="15,15,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                DockPanel.Dock="Left"
                                FontFamily="Segoe UI Variable Text"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{StaticResource Textcolor}"
                                Text="{Binding CurrentMessage,FallbackValue=Acceuil}" />

                            
                            <Button
                                Width="50"
                                Height="50"
                                Margin="0,15,15,0"
                                VerticalAlignment="Top"
                                BorderThickness="0"
                                Command="{Binding ShowProfileContent}"
                                DockPanel.Dock="Right"
                                Style="{StaticResource TopButton}">
                                <Ellipse
                                    Width="40"
                                    Height="40"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="ProfilePict" />
                                    </Ellipse.Fill>
                                </Ellipse>

                            </Button>
                            <Button
                                Grid.Column="2"
                                Width="40"
                                Height="40"
                                Margin="10,20,15,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource Elementbackground}"
                                BorderThickness="0"
                                Command="{Binding DirectResp}"
                                DockPanel.Dock="Right"
                                Style="{StaticResource TopButton}"
                                Tag="{StaticResource Textcolor}">
                                <fs:IconImage
                                    Width="32"
                                    Height="32"
                                    Foreground="{StaticResource Textcolor}"
                                    Icon="QuestionCircle"
                                    Style="{StaticResource TopButtonIconrad}" />
                            </Button>
                            <Border
                                Grid.Column="2"
                                Width="400"
                                Height="50"
                                Margin="20,15,20,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource Elementbackground}"
                                CornerRadius="25">
                                <DockPanel>
                                    <fs:IconImage
                                        Width="22"
                                        Height="22"
                                        Margin="10,0,0,0"
                                        Foreground="{StaticResource Textcolor}"
                                        Icon="Search"
                                        Style="{StaticResource TopButtonIcon}" />
                                    <ComboBox
                                        Margin="10,0,16,0"
                                        Height="51"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        materialDesign:HintAssist.Hint="Chercher vos quizzs"
                                        ItemsSource="{Binding Chapter}"
                                        SelectedItem="{Binding SelectedItem}"
                                        Style="{StaticResource SearchBox}">
                                    </ComboBox>
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </Grid>
                </Border>



                <Grid Grid.Column="0">
                    <DockPanel>
                        <Button
                            Width="15"
                            Height="15"
                            Margin="10,10,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Background="#fc6065"
                            BorderThickness="0"
                            Click="Exit_Click"
                            Command="{Binding ExitCommand}"
                            DockPanel.Dock="Left"
                            Style="{StaticResource TopButton}"
                            Tag="{StaticResource Exit}">
                            <fs:IconImage Icon="Xmark" Style="{StaticResource TopButtonIcon}" />
                        </Button>
                        <Button
                            Width="15"
                            Height="15"
                            Margin="10,10,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#fedf43"
                            BorderThickness="0"
                            Click="Minimize_Click"
                            Command="{Binding MinimizeCommand}"
                            DockPanel.Dock="Left"
                            Style="{StaticResource TopButton}"
                            Tag="{StaticResource Minimize}">
                            <fs:IconImage Icon="Minus" Style="{StaticResource TopButtonIcon}" />
                        </Button>
                        <Button
                            Width="15"
                            Height="15"
                            Margin="10,10,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#4ad969"
                            BorderThickness="0"
                            Click="Maximize_Click"
                            Command="{Binding MaximizeCommand}"
                            DockPanel.Dock="Left"
                            Style="{StaticResource TopButton}"
                            Tag="{StaticResource Maximize}">
                            <fs:IconImage
                                Width="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Icon="Expand"
                                Style="{StaticResource TopButtonIcon}" />
                        </Button>
                    </DockPanel>
                    <Border
                        Margin="10,40,0,10"
                        Background="{StaticResource Elementbackground}"
                        CornerRadius="17">
                        <Grid Grid.Column="0">
                            <DockPanel>
                                <Button 
                                    Width="50"
                                    Height="50"
                                    Margin="0,15,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    BorderThickness="0"
                                    Command="{Binding AcceuilClick}"
                                    DockPanel.Dock="top">
                                    <Button.Background>
                                    <ImageBrush ImageSource="images/Lofi_Girl_logo_2024-removebg-preview.png" />
                                    </Button.Background>
                                </Button>
                                
                                <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Margin="0,30,0,0" DockPanel.Dock="Top" Orientation="Vertical"></StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton
                                    Margin="0,10,0,0"
                                    Command="{Binding SelectCommand}"
                                    GroupName="MyRadioGroup"
                                    DockPanel.Dock="Top"
                                    Style="{StaticResource NewMButtton}">
                                    <DockPanel >
                                        <Rectangle
                                            Width="5"
                                            Height="25"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Left"
                                            Fill="{StaticResource Textcolor}"
                                            RadiusX="5"
                                            RadiusY="5"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" >
                                            <Rectangle.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="20"
                                                    Direction="270"
                                                    Opacity="0.3"
                                                    ShadowDepth="0"
                                                    Color="White" />
                                            </Rectangle.Effect>
                                        </Rectangle>
                                        <fs:IconImage
                                            DockPanel.Dock="Left"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Icon="{Binding IconVal}"
                                            Style="{StaticResource NewMButtonIcon}" />
                                    </DockPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                                
                                <RadioButton
                                    Margin="0,10,0,0"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding ShowSettingCommand}"
                                    DockPanel.Dock="Bottom"
                                    Style="{StaticResource NewMButtton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle
                                            x:Name="Rect6"
                                            Width="0"
                                            Height="20"
                                            Margin="0,0,0,0"
                                            Fill="MediumSlateBlue"
                                            RadiusX="5"
                                            RadiusY="5"
                                            Visibility="Hidden">
                                            <Rectangle.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="20"
                                                    Direction="270"
                                                    Opacity="0.3"
                                                    ShadowDepth="0"
                                                    Color="White" />
                                            </Rectangle.Effect>
                                        </Rectangle>
                                        <fs:IconImage
                                            Width="32"
                                            Height="32"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Icon="UserGear"
                                            Style="{StaticResource NewMButtonIcon}" />
                                    </StackPanel>
                                </RadioButton>


                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
                <Grid
                    Grid.Column="2"
                    Margin="10,80,10,10"
                    Background="Transparent"
                    Opacity="100">
                    <Grid.RowDefinitions>

                        <RowDefinition Height="10" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="2" CornerRadius="10">
                        <ContentControl x:Name="MainContentControl" />
                    </Border>




                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
