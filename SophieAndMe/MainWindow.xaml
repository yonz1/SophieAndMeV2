<Window
    x:Class="SophieAndMe.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SophieAndMe.MVVM.ViewModel"
    Title="MainWindow"
    Width="1280"
    Height="740"
    AllowsTransparency="False"
    FontFamily="{DynamicResource MaterialDesignFont}"
    Loaded="Window_Loaded"
    ResizeMode="CanResize"
    TextElement.FontSize="10"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Style/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource main_back_wind}">


        <Border Background="{StaticResource pageBackground}" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition />
                </Grid.RowDefinitions>


                <Border
                    x:Name="Border_top"
                    Grid.Row="0"
                    Background="Transparent"
                    CornerRadius="10"
                    MouseDown="Grid_MouseDown">
                    <Grid
                        x:Name="Grid_top"
                        Grid.Row="0"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        MouseDown="Grid_MouseDown"
                        Visibility="Visible">
                        <DockPanel Grid.Row="0">
                            <Button
                                Width="15"
                                Height="15"
                                Margin="10,17,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="#fc6065"
                                BorderThickness="0"
                                Click="Exit_Click"
                                Command="{Binding ExitCommand}"
                                DockPanel.Dock="Left"
                                Style="{StaticResource TopButton}"
                                Tag="{StaticResource Exit}">
                                <fs:IconImage Icon="Xmark" Style="{StaticResource TopButtonIcon}" />
                            </Button>
                            <Button
                                Width="15"
                                Height="15"
                                Margin="10,17,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#fedf43"
                                BorderThickness="0"
                                Click="Minimize_Click"
                                Command="{Binding MinimizeCommand}"
                                DockPanel.Dock="Left"
                                Style="{StaticResource TopButton}"
                                Tag="{StaticResource Minimize}">
                                <fs:IconImage Icon="Minus" Style="{StaticResource TopButtonIcon}" />
                            </Button>
                            <Button
                                Width="15"
                                Height="15"
                                Margin="10,17,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="#4ad969"
                                BorderThickness="0"
                                Click="Maximize_Click"
                                Command="{Binding MaximizeCommand}"
                                DockPanel.Dock="Left"
                                Style="{StaticResource TopButton}"
                                Tag="{StaticResource Maximize}">
                                <fs:IconImage
                                    Width="12"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Icon="Expand"
                                    Style="{StaticResource TopButtonIcon}" />
                            </Button>




                            <Button
                                Width="24"
                                Height="24"
                                Margin="15,15,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                BorderThickness="0"
                                Command="{Binding DirectResp}"
                                DockPanel.Dock="Left"
                                Style="{StaticResource TopButton}"
                                Tag="{StaticResource Textcolor}">
                                <fs:IconImage
                                    Width="24"
                                    Height="24"
                                    Foreground="{StaticResource Textcolor}"
                                    Icon="EyeSlash"
                                    Style="{StaticResource TopButtonIconrad}" />
                            </Button>



                            <Button
                                x:Name="Settings"
                                Height="40"
                                Margin="0,5,5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                Command="{Binding ShowSettingCommand}"
                                DockPanel.Dock="Right"
                                Style="{StaticResource MaterialDesignFlatDarkBgButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse
                                        Width="32"
                                        Height="32"
                                        Margin="0,0,15,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Right">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="ProfilePict" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock
                                        x:Name="Userbtncontent"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="{StaticResource Textcolor}"
                                        Text="Username" />
                                </StackPanel>
                            </Button>
                            <Button
                                Width="24"
                                Height="24"
                                Margin="10,15,10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                BorderThickness="0"
                                Command="{Binding DirectResp}"
                                DockPanel.Dock="Right"
                                Style="{StaticResource TopButton}"
                                Tag="{StaticResource Textcolor}">
                                <fs:IconImage
                                    Width="24"
                                    Height="24"
                                    Foreground="{StaticResource Textcolor}"
                                    Icon="QuestionCircle"
                                    Style="{StaticResource TopButtonIconrad}" />
                            </Button>
                            <Border
                                Height="30"
                                Margin="20,12,20,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource Elementbackground}"
                                CornerRadius="10">
                                <DockPanel>
                                    <fs:IconImage
                                        Width="20"
                                        Height="20"
                                        Margin="10,0,0,0"
                                        Foreground="Gainsboro"
                                        Icon="Search"
                                        Style="{StaticResource TopButtonIcon}" />
                                    <materialDesign:AutoSuggestBox
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        materialDesign:HintAssist.Hint="Chercher vos quizzs"
                                        FontSize="13"
                                        Foreground="{StaticResource Textcolor}"
                                        Style="{StaticResource MaterialDesignAutoSuggestBoxBase}" />
                                </DockPanel>
                            </Border>
                        </DockPanel>
                    </Grid>
                </Border>



                <Grid Grid.Row="1">


                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="100*" />
                        <ColumnDefinition Width="9*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource pageBackground}" CornerRadius="10 10 10 10">
                        <Grid Grid.Column="0">
                            <DockPanel>
                                <Rectangle
                                    Width="90"
                                    Height="90"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Top"
                                    DockPanel.Dock="top">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="images/Lofi_Girl_logo_2024-removebg-preview.png" />
                                    </Rectangle.Fill>
                                </Rectangle>

                                <ItemsControl ItemsSource="{Binding Subjects}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate />
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <RadioButton
                                    Margin="0,40,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding ShowQuizzCommand}"
                                    DockPanel.Dock="Top"
                                    Foreground="Gainsboro"
                                    Style="{StaticResource NewMButtton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle
                                            x:Name="Rect1"
                                            Width="5"
                                            Height="20"
                                            Margin="5,0,0,0"
                                            Fill="MediumSlateBlue"
                                            RadiusX="5"
                                            RadiusY="5"
                                            Visibility="Hidden">
                                            <Rectangle.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="20"
                                                    Direction="270"
                                                    Opacity="0.3"
                                                    ShadowDepth="0"
                                                    Color="White" />
                                            </Rectangle.Effect>
                                        </Rectangle>
                                        <fs:IconImage
                                            Margin="25,0,0,0"
                                            Foreground="{StaticResource Iconcolor}"
                                            Icon="UserGraduate"
                                            Style="{StaticResource NewMButtonIcon}" />
                                        <TextBlock
                                            Margin="20,0,0,0"
                                            Foreground="{StaticResource Textcolor}"
                                            Style="{StaticResource NewMButtonText}"
                                            Text="Quizz" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    Name="Markedval"
                                    Margin="0,10,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding ShowMarkedCommand}"
                                    DockPanel.Dock="Top"
                                    Style="{StaticResource NewMButtton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle
                                            x:Name="Rect2"
                                            Width="5"
                                            Height="20"
                                            Margin="5,0,0,0"
                                            Fill="MediumSlateBlue"
                                            RadiusX="5"
                                            RadiusY="5"
                                            Visibility="Hidden">
                                            <Rectangle.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="20"
                                                    Direction="270"
                                                    Opacity="0.3"
                                                    ShadowDepth="0"
                                                    Color="White" />
                                            </Rectangle.Effect>
                                        </Rectangle>
                                        <fs:IconImage
                                            Margin="25,0,0,0"
                                            Foreground="{StaticResource Iconcolor}"
                                            Icon="BookBookmark"
                                            Style="{StaticResource NewMButtonIcon}" />
                                        <TextBlock
                                            Margin="20,0,0,0"
                                            Foreground="{StaticResource Textcolor}"
                                            Style="{StaticResource NewMButtonText}"
                                            Text="Marked" />
                                    </StackPanel>
                                </RadioButton>


                                <RadioButton
                                    Name="Custom"
                                    Margin="0,10,0,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding ShowCustomCommand}"
                                    DockPanel.Dock="Top"
                                    Foreground="Gainsboro"
                                    Style="{StaticResource NewMButtton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Rectangle
                                            x:Name="Rect3"
                                            Width="5"
                                            Height="20"
                                            Margin="5,0,0,0"
                                            Fill="MediumSlateBlue"
                                            RadiusX="5"
                                            RadiusY="5"
                                            Visibility="Hidden">
                                            <Rectangle.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="20"
                                                    Direction="270"
                                                    Opacity="0.3"
                                                    ShadowDepth="0"
                                                    Color="White" />
                                            </Rectangle.Effect>
                                        </Rectangle>
                                        <fs:IconImage
                                            Margin="25,0,0,0"
                                            Foreground="{StaticResource Iconcolor}"
                                            Icon="PenToSquare"
                                            Style="{StaticResource NewMButtonIcon}" />
                                        <TextBlock
                                            Margin="20,0,0,0"
                                            Foreground="{StaticResource Textcolor}"
                                            Style="{StaticResource NewMButtonText}"
                                            Text="Custom" />
                                    </StackPanel>
                                </RadioButton>


                            </DockPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Background="{StaticResource pageBackground}" />
                    <Grid
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Background="Transparent"
                        Opacity="100">
                        <Grid.RowDefinitions>

                            <RowDefinition Height="10" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="2" CornerRadius="10">
                            <ContentControl Content="{Binding CurrentView}" />
                        </Border>


                    </Grid>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
