<Page
    x:Class="SophieAndMe.Test.Boutton_test"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:local="clr-namespace:SophieAndMe.Test"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Boutton_test"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <DockPanel
            Width="250"
            Height="120"
            Background="{StaticResource ElementbackgroundBlur}">
            <DockPanel Margin="10">
                <fs:IconImage
                    HorizontalAlignment="left"
                    VerticalAlignment="top"
                    DockPanel.Dock="Top"
                    Foreground="{StaticResource Iconcolor}"
                    Icon="subscript"
                    Style="{StaticResource NewMButtonIconSelected}" />
                <Label
                    Margin="0,6,0,0"
                    Content="{Binding}"
                    DockPanel.Dock="Top"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="{StaticResource Textcolor}" />
                <Button
                    Width="230"
                    Height="30"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Stretch"
                    Background="{StaticResource Elementbackground}"
                    BorderBrush="{StaticResource Elementbackground}"
                    Command="{Binding DataContext.ChoisirNomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}"
                    Content="Démarrer"
                    FontSize="16"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource button_quizz_desi}" />
            </DockPanel>
        </DockPanel>
    </Grid>

</Page>



