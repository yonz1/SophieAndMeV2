<Window
    x:Class="SophieAndMe.Windows.ImportAdd"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:local="clr-namespace:SophieAndMe.Windows"
    core:DialogCloser.DialogResult="{Binding DialogResult}"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:core="clr-namespace:SophieAndMe.Core"
    Title="ImportAdd"
    Width="800"
    Height="450"
    AllowsTransparency="False"
    FontFamily="{DynamicResource MaterialDesignFont}"
    ResizeMode="CanResize"
    TextElement.FontSize="10"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Style/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource main_back_wind}">
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Background="{StaticResource pageBackground}">
            <Button
                Margin="10,0,5,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="#fc6065"
                BorderThickness="0"
                Command="{Binding ExitCommand}"
                DockPanel.Dock="Left"
                Style="{StaticResource TopButton}"
                Tag="{StaticResource Exit}">
                <fs:IconImage Icon="Xmark" Style="{StaticResource TopButtonIcon}" />
            </Button>
        </DockPanel>

        <Grid Grid.Row="1" Background="{StaticResource Elementbackground}">
            <wv2:WebView2
                x:Name="WebView2"
                Margin="30,30,30,30"
                Panel.ZIndex="2"
                Visibility="Visible" />
        </Grid>

        <Grid Grid.Row="2" Background="{StaticResource Elementbackground}">
            <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ComboBox
                    Width="300"
                    Height="40"
                    Margin="0,0,70,0"
                    materialDesign:HintAssist.Hint="Chercher vos quizzs"
                    materialDesign:ThemeAssist.Theme="Dark"
                    DockPanel.Dock="Left"
                    ItemsSource="{Binding Chapter}"
                    SelectedItem="{Binding SelectedItem}"
                    Style="{StaticResource SearchBox}" />
                <Button
                    Width="120"
                    Height="40"
                    Margin="0,0,0,0"
                    BorderBrush="LimeGreen"
                    Command="{Binding AjouterAuQuizz}"
                    Content="Ajouter"
                    DockPanel.Dock="Left"
                    Foreground="LimeGreen"
                    Style="{StaticResource ButtonAddHover}" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
