        <!--  ########################################################## Panel d'affichage des matiére disponible  -->

        <Grid x:Name="Selection" Visibility="Visible">

            <Grid.RowDefinitions>
                <RowDefinition Height="100" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>


            <Border
                Height="50"
                Grid.Row="0"
                HorizontalAlignment="Center"
                Background="{StaticResource main_background}"
                BorderThickness="2"
                CornerRadius="20">
                <DockPanel
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    LastChildFill="True">

                    <ItemsControl ItemsSource="{Binding Subjects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"></StackPanel>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="1.5">
                                    <Button
                                        Width="55"
                                        Height="40"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        materialDesign:ButtonAssist.CornerRadius="20"
                                        Command="{Binding SelectCommand}"
                                        DockPanel.Dock="Left"
                                        Foreground="{StaticResource Textcolor}"
                                        Style="{StaticResource topquizzmat}">
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <fs:IconImage
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{StaticResource Iconcolor}"
                                                Icon="{Binding IconVal}"
                                                Style="{StaticResource NewMButtonIconSelected}" />
                                        </StackPanel>
                                    </Button>
                                    <Label
                                        Margin="0,0,1.5,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}" 
                                        Content="{Binding Name}"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource Textcolor}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!--  ✅ Affichage dynamique des boutons  -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                <ItemsControl ItemsSource="{Binding Noms}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="250"
                                Height="50"
                                Margin="50,10,10,10"
                                Background="{StaticResource Elementbackground}"
                                BorderBrush="{StaticResource Elementbackground}"
                                Command="{Binding DataContext.ChoisirNomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="{Binding}"
                                FontSize="14"
                                Foreground="White"
                                Style="{StaticResource button_quizz_desi}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

</UserControl>