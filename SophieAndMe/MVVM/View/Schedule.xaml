<UserControl
    x:Class="SophieAndMe.MVVM.View.Schedule"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SophieAndMe.MVVM.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="40" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="1">
            <DockPanel
                Margin="0,22.76,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                DockPanel.Dock="Top">
                <Rectangle
                    Width="10"
                    Height="0.5"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Fill="{StaticResource Textcolor}" />
                <TextBlock
                    Height="15"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="{StaticResource Textcolor}"
                    Text="8h" />
            </DockPanel>
            <DockPanel
                Margin="0,17,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                DockPanel.Dock="Top">
                <Rectangle
                    Width="10"
                    Height="0.5"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Fill="{StaticResource Textcolor}" />
                <TextBlock
                    Height="15"
                    Margin="0,0,5,0"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="{StaticResource Textcolor}"
                    Text="9h" />
            </DockPanel>
        </DockPanel>

        <Grid Grid.Column="2" Margin="0,30,30,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <DockPanel
                Grid.Row="0"
                Grid.Column="0"
                Background="#636363">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Top"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="Gainsboro">
                    Lundi
                </TextBlock>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Top"
                    FontWeight="Bold"
                    Foreground="Gainsboro">
                    06
                </TextBlock>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
