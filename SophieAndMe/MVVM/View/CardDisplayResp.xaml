<UserControl x:Class="SophieAndMe.MVVM.View.CardDisplayResp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Style/Dark_theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Button
            Width="120"
            Height="50"
            Grid.Row="0"
            Margin="30,0,0,0"
            HorizontalAlignment="Left"
            Command="{Binding Back_quizz_Click}"
            Foreground="Gainsboro"
            Style="{StaticResource MaterialDesignFlatButton}">
            <StackPanel Orientation="Horizontal">
                <fs:IconImage
                    Width="20"
                    Height="20"
                    Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"
                    Icon="ArrowLeft" />
                <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="Matières" />
            </StackPanel>
        </Button>
        <Label Content="{Binding Message}" Grid.Row="0" Foreground="{StaticResource Textcolor}"
               FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <wv2:WebView2 x:Name="WebViewAll" Grid.Row="1"  />
    </Grid>
</UserControl>
