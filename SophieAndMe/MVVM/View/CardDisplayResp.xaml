<UserControl
    x:Class="SophieAndMe.MVVM.View.CardDisplayResp"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Button
            Grid.Row="0"
            Width="120"
            Height="50"
            Margin="30,0,0,0"
            HorizontalAlignment="Left"
            Command="{Binding Back_quizz_Click}"
            Foreground="Gainsboro"
            Style="{StaticResource MaterialDesignFlatButton}">
            <StackPanel Orientation="Horizontal">
                <fs:IconImage
                    Width="20"
                    Height="20"
                    Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"
                    Icon="ArrowLeft" />
                <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="Retour" />
            </StackPanel>
        </Button>
        <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="Microsoft Sans Serif"
            FontSize="15"
            Foreground="{StaticResource Textcolor}"
            Text="{Binding Message}"
            TextDecorations="Underline" />
        <wv2:WebView2 x:Name="WebViewAll" Grid.Row="1" />
    </Grid>
</UserControl>
