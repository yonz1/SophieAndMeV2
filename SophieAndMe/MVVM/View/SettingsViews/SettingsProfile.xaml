    <!--  Version 2 de la page  -->



    <Grid Margin="30,0,0,0">
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
            <DockPanel>
                <Grid VerticalAlignment="Top" DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <Label
                            Content="Profile"
                            DockPanel.Dock="Top"
                            Style="{StaticResource TitleSettings}" />
                        <Label
                            Content="Configurez les détails de votre compte"
                            DockPanel.Dock="Top"
                            Style="{StaticResource SecondaryTextSettings}" />
                    </DockPanel>

                    <DockPanel Grid.Column="1">
                        <Grid
                            Margin="0,10,0,0"
                            VerticalAlignment="Top"
                            DockPanel.Dock="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Label
                                    Margin="30,0,0,0"
                                    Content="Name"
                                    DockPanel.Dock="Top"
                                    Style="{StaticResource SecondaryTextSettings}" />
                                <TextBox
                                    Margin="30,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource SettingsTextBox}"
                                    Text="Admin" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <Label
                                    Margin="30,0,0,0"
                                    Content="Surname"
                                    DockPanel.Dock="Top"
                                    Style="{StaticResource SecondaryTextSettings}" />
                                <TextBox
                                    Margin="30,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Style="{StaticResource SettingsTextBox}"
                                    Text="Admin" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <Label
                                Margin="30,15,0,0"
                                Content="E-mail"
                                DockPanel.Dock="Top"
                                Style="{StaticResource SecondaryTextSettings}" />
                            <TextBox
                                Margin="30,0,0,30"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource SettingsTextBox}"
                                Text="admin@gmail.com" />
                        </StackPanel>


                    </DockPanel>

                    <DockPanel Grid.Column="3">
                        <Ellipse
                            Width="135"
                            Height="135"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            DockPanel.Dock="Top">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="Profilepicture" ImageSource="../../../images/Ryan-Gosling_0.jpg" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <DockPanel
                            Margin="10,10,0,0"
                            VerticalAlignment="Top"
                            DockPanel.Dock="Top">
                            <Button
                                Width="100"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Command="{Binding Settings}"
                                Content="Edit photo"
                                FontSize="14"
                                Style="{StaticResource RoundedButtonSettings}" />
                            <Button
                                Width="27"
                                Height="27"
                                Margin="15,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                materialDesign:ThemeAssist.Theme="Light"
                                Command="{Binding EditPhoto}"
                                Style="{StaticResource MaterialDesignIconButton}">
                                <fs:IconImage
                                    Width="24"
                                    Height="24"
                                    Foreground="{StaticResource Textcolor}"
                                    Icon="Trash" />
                            </Button>
                        </DockPanel>
                    </DockPanel>
                </Grid>


                <!--  ############################################################### Identificateur  -->

                <Rectangle
                    Height="1"
                    Margin="0,10,30,0"
                    VerticalAlignment="Top"
                    DockPanel.Dock="Top"
                    Fill="{StaticResource Top_iconc_unused}" />
                <Grid
                    Margin="0,25,0,25"
                    VerticalAlignment="Top"
                    DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0">
