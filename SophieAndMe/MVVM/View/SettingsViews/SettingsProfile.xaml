                            Content="Configurez les différents groupe auquel vous appartenez"
                            DockPanel.Dock="Top"
                            Style="{StaticResource SecondaryTextSettings}" />
                    </DockPanel>
                    <Grid
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Margin="0,10,0,0"
                        VerticalAlignment="Top"
                        DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label
                                Margin="30,0,0,0"
                                Content="Groupe de kholle"
                                DockPanel.Dock="Top"
                                Style="{StaticResource SecondaryTextSettings}" />
                            <TextBox
                                Margin="30,0,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource SettingsTextBox}"
                                Text="7" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Label
                                Margin="30,0,0,0"
                                Content="Groupe de classe"
                                DockPanel.Dock="Top"
                                Style="{StaticResource SecondaryTextSettings}" />
                            <TextBox
                                Margin="30,0,0,0"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource SettingsTextBox}"
                                Text="GA" />
                        </StackPanel>
                    </Grid>
                </Grid>

