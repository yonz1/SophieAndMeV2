<UserControl
    x:Class="SophieAndMe.MVVM.View.AllQuizzSelect"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Button
            Width="120"
            Height="50"
            Margin="0,0,0,0"
            HorizontalAlignment="Left"
            Command="{Binding BackQuizzClick}"
            Foreground="Gainsboro"
            Style="{StaticResource MaterialDesignFlatButton}">
            <StackPanel Orientation="Horizontal">
                <fs:IconImage
                    Width="20"
                    Height="20"
                    Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"
                    Icon="ArrowLeft" />
                <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="Matières" />
            </StackPanel>
        </Button>
        
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <Border Background="{StaticResource Elementbackground}" CornerRadius="20" Margin="10 10 10 10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <Button  HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="15 0 0 0"
                            Command="{Binding Fill}"
                            Content="Fill" Style="{StaticResource MaterialDesignOutlinedLightButton}"/>
                    <Button HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="15 0 0 0"
                            Command="{Binding Clear}"
                            Content="Clear" Style="{StaticResource MaterialDesignOutlinedLightButton}"/>
                </DockPanel>
                <TextBlock Grid.Row="0" Text="Choisissez vos Chapitre" 
                           Foreground="{StaticResource Textcolor}"
                           FontWeight="DemiBold"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Margin="10 10 10 0"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  Width="320"
                                  Height="40"
                                  Content="{Binding Name }"
                                  FontFamily="Segoe UI Variable Text"
                                  Margin="50 20 0 0"
                                  FontSize="15"
                                  FontWeight="DemiBold"
                                  Foreground="{StaticResource Textcolor}"
                                  IsChecked="{Binding IsChecked,Mode=TwoWay,FallbackValue=True}"
                                  Style="{StaticResource MaterialDesignCheckBox}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
                <DockPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 20 0 20">
                <Button  DockPanel.Dock="Left"
                        Command="{Binding StartQuizz}"
                        Content="Tout" Style="{StaticResource MaterialDesignOutlinedLightButton}"/>
                <Rectangle Fill="White" Margin="20 0 0 0" Width="2" DockPanel.Dock="Left" HorizontalAlignment="Center"/>
                <Button  DockPanel.Dock="Left"
                        Margin="20 0 0 0"
                        Command="{Binding Reinitialiser}"
                        Content="Reinitialiser"
                        Foreground="Red"
                        BorderBrush="Red"
                        Style="{StaticResource MaterialDesignOutlinedLightButton}"/>
                <Button  DockPanel.Dock="Left"
                        Margin="10 0 0 0"
                        Command="{Binding Continuer}"
                        Content="{Binding ProgValue}" Style="{StaticResource MaterialDesignOutlinedLightButton}"/>
                </DockPanel>
            </Grid>
        </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
