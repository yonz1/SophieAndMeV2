<UserControl
    x:Class="SophieAndMe.MVVM.View.VCustom"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core1="clr-namespace:SophieAndMe.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    d:DesignHeight="740"
    d:DesignWidth="1280"
    Background="Transparent"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="10"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">


    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel
            Height="50"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <DockPanel Visibility="{Binding IsViewReturn, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Hidden}">
                <Button
                    Width="30"
                    Height="30"
                    Margin="0,0,30,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    BorderThickness="0"
                    Command="{Binding Return}"
                    DockPanel.Dock="Left"
                    Style="{StaticResource TopButton}"
                    Tag="{StaticResource Textcolor}">
                    <fs:IconImage
                        Width="24"
                        Height="24"
                        Foreground="{StaticResource Textcolor}"
                        Icon="ChevronLeft"
                        Style="{StaticResource TopButtonIconrad}" />
                </Button>
            </DockPanel>
            <Border
                Height="60"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                CornerRadius="30">
                <DockPanel>
                    <RadioButton
                        GroupName="Matier"
                        Margin="5,0,5,0"
                        VerticalAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="20"
                        Command="{Binding Create}"
                        DockPanel.Dock="Left"
                        Style="{StaticResource topquizzmat}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                Margin="0,0,1.5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="Create"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{StaticResource Textcolor}"/>
                        </StackPanel>
                    </RadioButton>
                    <!-- <RadioButton -->
                    <!--     Margin="5,0,5,0" -->
                    <!--     GroupName="Matier" -->
                    <!--     VerticalAlignment="Center" -->
                    <!--     materialDesign:ButtonAssist.CornerRadius="20" -->
                    <!--     Command="{Binding FFCComm}" -->
                    <!--     DockPanel.Dock="Left" -->
                    <!--     Style="{StaticResource topquizzmat}"> -->
                    <!--     <StackPanel -->
                    <!--         HorizontalAlignment="Center" -->
                    <!--         VerticalAlignment="Center" -->
                    <!--         Orientation="Horizontal"> -->
                    <!--         <Label -->
                    <!--             Margin="0,0,1.5,0" -->
                    <!--             HorizontalAlignment="Center" -->
                    <!--             VerticalAlignment="Center" -->
                    <!--             Content="FFC" -->
                    <!--             FontSize="16" -->
                    <!--             FontWeight="Bold" -->
                    <!--             Foreground="{StaticResource Textcolor}"/> -->
                    <!--     </StackPanel> -->
                    <!-- </RadioButton> -->
                    <RadioButton
                        Margin="5,0,5,0"
                        VerticalAlignment="Center"
                        GroupName="Matier"
                        materialDesign:ButtonAssist.CornerRadius="20"
                        Command="{Binding Created}"
                        DockPanel.Dock="Left"
                        Style="{StaticResource topquizzmat}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                Margin="0,0,1.5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="Created"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{StaticResource Textcolor}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                        Margin="5,0,5,0"
                        GroupName="Matier"
                        VerticalAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="20"
                        Command="{Binding Import}"
                        DockPanel.Dock="Left"
                        Style="{StaticResource topquizzmat}">
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Label
                                Margin="0,0,1.5,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="Importer"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{StaticResource Textcolor}"/>
                        </StackPanel>
                    </RadioButton>
                    
                </DockPanel>
            </Border>
        </DockPanel>
        
        <wv2:WebView2
            x:Name="WebViewCustom"
            Grid.Row="1"
            Panel.ZIndex="2"
            Visibility="{Binding IsView, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Hidden}" />

        <wv2:WebView2
            x:Name="WebViewCard"
            Grid.Row="1"
            Visibility="{Binding IsViewCard, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Hidden}" />
        <ContentControl
            Visibility="{Binding IsViewFFC, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Hidden}"
            x:Name="ViewFFC"
            Panel.ZIndex="2"
            Grid.Row="1"/>

        <ContentControl x:Name="WebViewDisplayPresenter" Grid.Row="1" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding Matier}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- <Button -->
                        <!--     Width="250" -->
                        <!--     Height="50" -->
                        <!--     Margin="50,10,10,10" -->
                        <!--     Background="{StaticResource Elementbackground}" -->
                        <!--     BorderBrush="{StaticResource Elementbackground}" -->
                        <!--     Command="{Binding DataContext.ChoisirMatierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" -->
                        <!--     CommandParameter="{Binding}" -->
                        <!--     Content="{Binding}" -->
                        <!--     FontSize="14" -->
                        <!--     Foreground="{StaticResource Textcolor}" -->
                        <!--     Style="{StaticResource button_quizz_desi}" /> -->
                        <Border
                            CornerRadius="20"
                            Margin="10,10,10,10"
                            Width="250"
                            Height="auto"
                            Background="{StaticResource ElementbackgroundBlur}">
                            <DockPanel Margin="10">
                                <fs:IconImage
                                    HorizontalAlignment="left"
                                    VerticalAlignment="top"
                                    DockPanel.Dock="Top"
                                    Foreground="{StaticResource Iconcolor}"
                                    Icon="subscript"
                                    Style="{StaticResource NewMButtonIconSelected}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    Text="{Binding}"
                                    TextWrapping="Wrap"
                                    DockPanel.Dock="Top"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Textcolor}" />
                                <Button
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.ChoisirMatierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource button_quizz_desi}" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
