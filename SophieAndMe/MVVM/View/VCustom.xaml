<UserControl x:Class="SophieAndMe.MVVM.View.VCustom"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:core1="clr-namespace:SophieAndMe.Core"
             mc:Ignorable="d"
             d:DesignHeight="740"
             d:DesignWidth="1280"
             Background="Transparent"
             FontFamily="{DynamicResource MaterialDesignFont}"
             TextElement.FontSize="10"
             TextElement.FontWeight="Regular"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto">
    <UserControl.Resources>
        <ResourceDictionary>
            <core1:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Style/ButtonStyle.xaml" />
                <ResourceDictionary Source="/Style/Dark_theme.xaml" />
                <ResourceDictionary Source="/Style/General.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Height="50"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource main_background}"
            BorderThickness="2"
            CornerRadius="20">
            <DockPanel
                Height="60"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent">
                <Button
                    Width="120"
                    Height="40"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Command="{Binding Create}"
                    Content="Create"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="Mathématiques" />
                <Button
                    Width="120"
                    Height="40"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Background="Transparent"
                    Command="{Binding Created}"
                    Content="Created"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="Physique" />
            </DockPanel>
        </Border>
        
        <Button
            Width="120"
            Height="50"
            Grid.Row="0"
            Margin="30,0,0,0"
            HorizontalAlignment="Left"
            Command="{Binding Back_quizz_Click}"
            Foreground="Gainsboro"
            Style="{StaticResource MaterialDesignFlatButton}">
            <StackPanel Orientation="Horizontal">
                <fs:IconImage
                    Width="20"
                    Height="20"
                    Foreground="{Binding RelativeSource={RelativeSource AncestorType={x:Type Button}}, Path=Foreground}"
                    Icon="ArrowLeft" />
                <TextBlock
                    Margin="15,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="Matières" />
            </StackPanel>
        </Button>
        
        <wv2:WebView2
                    x:Name="WebViewCustom"
                    Grid.Row="1"
                    Visibility="{Binding IsView, Converter={StaticResource BoolToVisibilityConverter}}"/>
        
        <wv2:WebView2
            x:Name="WebViewCard"
            Grid.Row="1"
            Visibility="{Binding IsViewCard, Converter={StaticResource BoolToVisibilityConverter}}"/>
            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" >
                <ItemsControl ItemsSource="{Binding Matier}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="250"
                                Height="50"
                                Margin="50,10,10,10"
                                Background="{StaticResource Elementbackground}"
                                BorderBrush="{StaticResource Elementbackground}"
                                Command="{Binding DataContext.ChoisirMatierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="{Binding}"
                                FontSize="14"
                                Foreground="White"
                                Style="{StaticResource button_quizz_desi}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
    </Grid>
</UserControl>
