<UserControl
    x:Class="SophieAndMe.MVVM.View.VCustom"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core1="clr-namespace:SophieAndMe.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    d:DesignHeight="740"
    d:DesignWidth="1280"
    Background="Transparent"
    FontFamily="{DynamicResource MaterialDesignFont}"
    TextElement.FontSize="10"
    TextElement.FontWeight="Regular"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="Auto"
    mc:Ignorable="d">


    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel
            Height="50"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            >
           
            <DockPanel  Visibility="{Binding IsViewReturn, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Hidden}">
            <Button
                Width="30"
                Height="30"
                Margin="0,0,30,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                BorderThickness="0"
                Command="{Binding Return}"
                DockPanel.Dock="Left"
                Style="{StaticResource TopButton}"
                Tag="{StaticResource Textcolor}">
                <fs:IconImage
                    Width="24"
                    Height="24"
                    Foreground="{StaticResource Textcolor}"
                    Icon="ChevronLeft"
                    Style="{StaticResource TopButtonIconrad}" />
            </Button>
            </DockPanel>
            <Border
                Height="60"
                Margin="20,0,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource main_background}"
                BorderThickness="2"
                CornerRadius="30">
                <DockPanel>
                    <Button
                        Width="120"
                        Height="40"
                        Margin="5,0,5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="20"
                        Command="{Binding Create}"
                        Content="Create"
                        DockPanel.Dock="Left"
                        Foreground="{StaticResource Textcolor}"
                        Style="{StaticResource topquizzmat}"
                        Tag="Mathématiques" />
                    <Button
                        Width="120"
                        Height="40"
                        Margin="5,0,5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        materialDesign:ButtonAssist.CornerRadius="20"
                        Background="Transparent"
                        Command="{Binding Created}"
                        Content="Created"
                        DockPanel.Dock="Left"
                        Foreground="{StaticResource Textcolor}"
                        Style="{StaticResource topquizzmat}"
                        Tag="Physique" />
                    <!-- <Button -->
                    <!--     Width="120" -->
                    <!--     Height="40" -->
                    <!--     Margin="5,0,5,0" -->
                    <!--     HorizontalAlignment="Center" -->
                    <!--     VerticalAlignment="Center" -->
                    <!--     materialDesign:ButtonAssist.CornerRadius="20" -->
                    <!--     Background="Transparent" -->
                    <!--     Command="{Binding Import}" -->
                    <!--     Content="Importer" -->
                    <!--     DockPanel.Dock="Left" -->
                    <!--     Foreground="{StaticResource Textcolor}" -->
                    <!--     Style="{StaticResource topquizzmat}" -->
                    <!--     Tag="Physique" /> -->
                </DockPanel>
            </Border>
        </DockPanel>


        <wv2:WebView2
            x:Name="WebViewCustom"
            Grid.Row="1"
            Panel.ZIndex="2"
            Visibility="{Binding IsView, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Hidden}" />

        <wv2:WebView2
            x:Name="WebViewCard"
            Grid.Row="1"
            Visibility="{Binding IsViewCard, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Hidden}" />
        
        <ContentControl Grid.Row="1" x:Name="WebViewDisplayPresenter" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding Matier}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Width="250"
                            Height="50"
                            Margin="50,10,10,10"
                            Background="{StaticResource Elementbackground}"
                            BorderBrush="{StaticResource Elementbackground}"
                            Command="{Binding DataContext.ChoisirMatierCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{Binding}"
                            FontSize="14"
                            Foreground="White"
                            Style="{StaticResource button_quizz_desi}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
