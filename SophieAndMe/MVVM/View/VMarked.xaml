<UserControl
    x:Class="SophieAndMe.MVVM.View.VMarked"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fs="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
    xmlns:local="clr-namespace:SophieAndMe.MVVM.View"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Style/ButtonStyle.xaml" />
                <ResourceDictionary Source="/Style/Dark_theme.xaml" />
                <ResourceDictionary Source="/Style/General.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <Border
            Height="50"
            HorizontalAlignment="Center"
            Background="{StaticResource main_background}"
            BorderThickness="2"
            CornerRadius="20">
            <DockPanel
                Height="50"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="Transparent"
                LastChildFill="True">
                <Button
                    x:Name="Maths"
                    Width="55"
                    Height="40"
                    Margin="2.5,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Command="{Binding ShowMaths}"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="Mathématiques">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <fs:IconImage
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Iconcolor}"
                            Icon="Superscript"
                            Style="{StaticResource NewMButtonIcon}" />
                    </StackPanel>
                </Button>
                <Label
                    x:Name="Maths_label"
                    Margin="0,0,2.5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Maths"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource Textcolor}"
                    Visibility="Collapsed" />



                <Button
                    x:Name="Physique"
                    Width="55"
                    Height="40"
                    Margin="2.5,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Command="{Binding ShowPhysique}"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="Physique">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <fs:IconImage
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Iconcolor}"
                            Icon="Atom"
                            Style="{StaticResource NewMButtonIcon}" />
                    </StackPanel>
                </Button>
                <Label
                    x:Name="Physique_label"
                    Margin="0,0,2.5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Physique"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource Textcolor}"
                    Visibility="Collapsed" />




                <Button
                    x:Name="SI"
                    Width="55"
                    Height="40"
                    Margin="2.5,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Command="{Binding ShowSI}"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="SI">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <fs:IconImage
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Iconcolor}"
                            Icon="Gears"
                            Style="{StaticResource NewMButtonIcon}" />
                    </StackPanel>
                </Button>
                <Label
                    x:Name="SI_label"
                    Margin="0,0,2.5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="SI"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource Textcolor}"
                    Visibility="Collapsed" />




                <Button
                    x:Name="Français"
                    Width="55"
                    Height="40"
                    Margin="2.5,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Command="{Binding ShowFrançais}"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="Français">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <fs:IconImage
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Iconcolor}"
                            Icon="Book"
                            Style="{StaticResource NewMButtonIcon}" />
                    </StackPanel>
                </Button>
                <Label
                    x:Name="Français_label"
                    Margin="0,0,2.5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Français"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource Textcolor}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="Anglais"
                    Width="55"
                    Height="40"
                    Margin="2.5,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Command="{Binding ShowAnglais}"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="Anglais">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <fs:IconImage
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Iconcolor}"
                            Icon="EarthAmericas"
                            Style="{StaticResource NewMButtonIcon}" />
                    </StackPanel>
                </Button>
                <Label
                    x:Name="Anglais_label"
                    Margin="0,0,2.5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Anglais"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource Textcolor}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="Erreur"
                    Width="55"
                    Height="40"
                    Margin="2.5,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Command="{Binding ShowErreurs}"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="Erreurs">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <fs:IconImage
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Iconcolor}"
                            Icon="Superpowers"
                            Style="{StaticResource NewMButtonIcon}" />
                    </StackPanel>
                </Button>
                <Label
                    x:Name="Erreurs_label"
                    Margin="0,0,2.5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Erreurs"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource Textcolor}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="All"
                    Width="55"
                    Height="40"
                    Margin="2.5,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Command="{Binding ShowAll}"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="All">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <fs:IconImage
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Iconcolor}"
                            Icon="Landmark"
                            Style="{StaticResource NewMButtonIcon}" />
                    </StackPanel>
                </Button>
                <Label
                    x:Name="All_label"
                    Margin="0,0,2.5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="All"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource Textcolor}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="Quizz"
                    Width="55"
                    Height="40"
                    Margin="2.5,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="20"
                    Command="{Binding ShowQuizzMarked}"
                    DockPanel.Dock="Left"
                    Foreground="{StaticResource Textcolor}"
                    Style="{StaticResource topquizzmat}"
                    Tag="All">
                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <fs:IconImage
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Iconcolor}"
                            Icon="FilePen"
                            Style="{StaticResource NewMButtonIcon}" />
                    </StackPanel> 
                </Button>
                <Label
                    x:Name="Quizz_label"
                    Margin="0,0,2.5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Quizz"
                    FontSize="16"
                    FontWeight="Bold"
                    Foreground="{StaticResource Textcolor}"
                    Visibility="Collapsed" />
            </DockPanel>
        </Border>

        <wv2:WebView2
            x:Name="webviewall"
            Grid.Row="1"
            Margin="30"
            Source="file:///C:/Users/Bastien/source/repos/Sophieandme/Sophieandme/Math.html"/>
    </Grid>
</UserControl>
