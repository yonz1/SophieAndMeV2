<UserControl
    x:Class="SophieAndMe.MVVM.View.VAgenda"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SophieAndMe.MVVM.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30" />
            <ColumnDefinition Width="40" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" Margin="0,80,0,30">

            <!--  ############################################################################# Controle des temps  -->
            <ItemsControl ItemsSource="{Binding Hours}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Grid.Row" Value="{Binding RowID}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel
                            Margin="0,-7.5,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                            <Rectangle
                                Width="10"
                                Height="0.8"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                Fill="#8e8e93" />
                            <TextBlock
                                Height="15"
                                Margin="0,0,5,0"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{StaticResource Textcolor}"
                                Text="{Binding TopText}" />
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <Grid Grid.Column="2" Margin="0,80,30,30">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="12*" />
            </Grid.RowDefinitions>


            <!--  ############################################################################# Controle des jours  -->

            <ItemsControl Grid.Row="0" ItemsSource="{Binding DaysItem}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Grid.Column" Value="{Binding ColumnId}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Background="{StaticResource Elementbackground}"
                            BorderBrush="#8e8e93"
                            BorderThickness="0,0,0.8,0.8">
                            <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Top"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Textcolor}"
                                    Text="{Binding Date}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    DockPanel.Dock="Top"
                                    FontSize="8"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource Textcolor}"
                                    Text="{Binding Days}" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <!--  ############################################################################# Control d'evenements  -->

            <ItemsControl Grid.Row="1" ItemsSource="{Binding _TimeTableItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                        </Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Grid.Column" Value="{Binding ColumnId}" />
                        <Setter Property="Grid.Row" Value="{Binding RowId}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            BorderBrush="#8e8e93"
                            BorderThickness="0,0.8,0.8,0">
                            <Border Background="{Binding MatColor }" CornerRadius="5">
                                <DockPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Top"
                                        FontSize="17"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource Textcolor}"
                                        Text="{Binding Matiere }" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Top"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource Textcolor}"
                                        Text="{Binding Infos}" />
                                </DockPanel>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


